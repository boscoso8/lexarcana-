<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe e non WinExe: su Windows resta una console, così gli errori di connessione si vedono. -->
    <OutputType>Exe</OutputType>
    <AssemblyName>lexarcana-visione</AssemblyName>
    <RootNamespace>LexArcana.Visione</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LexArcana.Core\LexArcana.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
