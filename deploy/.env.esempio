# Copia questo file in .env e compilalo.
# Il nome di dominio del tavolo, già puntato all'indirizzo IP del server.
DOMINIO=tavolo.esempio.it
# Parola d'ordine dei giocatori (lascia vuoto per un tavolo aperto a chiunque abbia l'indirizzo).
LEXARCANA_PAROLA=
# Parola d'ordine del Demiurgo, per condurre da remoto. Sceglila lunga.
LEXARCANA_PAROLA_DEMIURGO=
# Campagna da caricare (la cartella ./dati del server è /dati nel container), facoltativa.
LEXARCANA_CAMPAGNA=
LEXARCANA_AVVENTURA=1
